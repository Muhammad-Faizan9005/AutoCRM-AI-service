APP_NAME=AutoCRM AI Agent Service
APP_ENV=development
LOG_LEVEL=info

# AutoCRM API
# Preferred: AI service credentials (issue via POST /api/agent/ai-agents/{key}/credentials)
# AUTOCRM_AI_AGENT_KEY=action_manager_agent
# AUTOCRM_AI_SERVICE_TOKEN=<raw_token_from_credential_creation>
#
# Legacy fallback: email/password (used only when AI_AGENT_KEY is blank)
AUTOCRM_BASE_URL=http://localhost:8000
AUTOCRM_AUTH_EMAIL=agent.action@autocrm.internal
AUTOCRM_AUTH_PASSWORD=change-me
AUTOCRM_AUTH_TIMEOUT=10
AUTOCRM_BATCH_TIMEOUT=60
AI_SERVICE_WEBHOOK_TOKEN=change-me-shared-token

# Database (needed for transcription job state; runs/actions/approvals live in backend)
DATABASE_URL=postgresql://user:pass@localhost:5432/autocrm_ai

# Shared meeting recordings storage
# Must match the backend AUTOCRM_RECORDINGS_DIR / CALL_RECORDINGS_DIR.
AUTOCRM_RECORDINGS_DIR=../AutoCRM/storage/recordings

# Scheduler
SCHEDULER_ENABLED=true

# LLM
LLM_PROVIDER=ollama
LLM_MODEL_SMALL=gemma2:2b
LLM_MODEL_LARGE=glm-4.6:cloud
LLM_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=

# RAG
VECTOR_STORE=faiss
RAG_INDEX_DIR=storage/faiss
RAG_SYNC_ENABLED=true
RAG_SYNC_INTERVAL_SECONDS=300
RAG_SYNC_BATCH_SIZE=100
RAG_SYNC_MIN_DELAY_SECONDS=0.05
RAG_SYNC_STATE_FILE=storage/rag_sync_state.json
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
